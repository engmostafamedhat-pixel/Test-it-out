{
  "name": "site-mission-reports",
  "version": "1.0.0",
  "description": "Offline-first mobile app (PWA) for site teams to file mission reports with photos, plus a back-office API and dashboard.",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
